# Copy to .env for local runs (cp env.example .env). On a hosting platform, set these as environment variables.

# Port to listen on. Most platforms (Render, Railway, Fly…) set PORT for you.
PORT=8080

# Google login. Create an OAuth 2.0 Client ID (type "Web application") at
# https://console.cloud.google.com/apis/credentials and add your site to "Authorized JavaScript origins",
# e.g. http://localhost:8080 and https://your-domain.com. Leave empty to play as guests only.
GOOGLE_CLIENT_ID=

# Signs the session cookie. Use a long random string, e.g. the output of:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If empty, a temporary key is generated and everyone is logged out when the server restarts.
SESSION_SECRET=

# true when the site is served over HTTPS (the cookie is then never sent over plain HTTP).
COOKIE_SECURE=false

# Behind nginx or a platform proxy (Render, Railway, Fly…): true, so the real client IP is read from X-Forwarded-For.
# Leave false when clients connect directly, otherwise anyone can fake their IP.
TRUST_PROXY=false

# Limits
MAX_ROOMS=500
# Open game connections per IP (each can hold a room). Raise it for LAN parties behind one router.
MAX_STREAMS_PER_IP=8
# How long a human may think before the bot plays for them (milliseconds).
TURN_MS=45000
